{
  "name": "ketabche-ghanoon",
  "private": true,
  "version": "1.1.0",
  "description": "کتابچه قانون ایران — PWA آفلاین برای مرور و جستجوی قوانین جمهوری اسلامی ایران",
  "author": {
    "name": "Karen Soft (کارن سافت)",
    "url": "https://karen-soft.ir"
  },
  "contributors": [
    {
      "name": "لیلا آبکه — وکیل پایه یک دادگستری (جمع‌آوری و تدوین اطلاعات)"
    }
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "data": "tsx scripts/bundle-data.ts",
    "data:laws": "python3 scripts/pipeline/build_laws.py && python3 scripts/pipeline/gen_docs.py",
    "data:sqlite": "python3 scripts/pipeline/export_sqlite.py",
    "data:all": "npm run data:laws && npm run data && npm run data:sqlite",
    "predev": "npm run data",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run data",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:py": "python3 -m unittest discover -s scripts/pipeline/tests -v",
    "icons": "node scripts/gen-icons.mjs",
    "size": "node scripts/report-size.mjs",
    "build:compress": "npm run build && node scripts/report-size.mjs --compress"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@khmyznikov/pwa-install": "^0.7.0",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^12.43.0",
    "lit": "^3.3.3",
    "lucide-react": "^1.50.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "web-push": "^3.6.7"
  }
}
