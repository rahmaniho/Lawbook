    { "term": "بیع", "match": ["بیع", "مبیع", "ثمن", "بایع", "خریدار", "فروشنده"], "expand": ["خرید و فروش", "فروش", "معامله", "مبایعه نامه", "قولنامه"] },
    { "term": "خیار و فسخ", "match": ["خیار", "فسخ", "اقاله", "انفساخ"], "expand": ["حق فسخ", "برهم زدن معامله", "پس دادن جنس"] },
    { "term": "قرارداد", "match": ["قرارداد", "عقد", "متعاملین", "تعهد"], "expand": ["پیمان", "توافق نامه"] },
    { "term": "خسارت", "match": ["خسارت", "ضمان", "اتلاف", "تسبیب", "ضامن"], "expand": ["جبران خسارت", "تاوان", "غرامت"] },
    { "term": "غصب و تصرف عدوانی", "match": ["غصب", "غاصب", "تصرف عدوانی", "ممانعت از حق", "مزاحمت"], "expand": ["تصاحب ملک", "خلع ید"] },
    { "term": "اموال غیرمنقول", "match": ["غیرمنقول", "غیر منقول", "عرصه", "اعیان"], "expand": ["ملک", "زمین", "خانه", "آپارتمان", "مسکن"] },
    { "term": "ثبت و سند رسمی", "match": ["سند رسمی", "دفتر اسناد رسمی", "سردفتر", "ثبت ملک", "اداره ثبت"], "expand": ["محضر", "سند تک برگ", "سند ملک"] },
    { "term": "صغیر و محجور", "match": ["صغیر", "محجور", "قیم", "ولی قهری", "سفیه", "مجنون", "حجر"], "expand": ["کودک", "بچه", "نوجوان", "قیمومت"] },
    { "term": "نسب و فرزند", "match": ["نسب", "فرزند", "اولاد", "طفل", "پدر", "مادر"], "expand": ["بچه", "فرزندخواندگی"] },
    { "term": "شرکت تجاری", "match": ["شرکت سهامی", "شرکت با مسئولیت محدود", "شرکت تضامنی", "سهامدار", "صاحبان سهام", "هیات مدیره", "مجمع عمومی"], "expand": ["ثبت شرکت", "سهام", "شرکا"] },
    { "term": "ورشکستگی", "match": ["ورشکستگی", "ورشکسته", "تاجر متوقف", "مدیر تصفیه"], "expand": ["افلاس", "ورشکست", "توقف از پرداخت"] },
    { "term": "تاجر", "match": ["تاجر", "معاملات تجارتی", "دفاتر تجارتی"], "expand": ["بازرگان", "کاسب"] },
    { "term": "کارگر و کارفرما", "match": ["کارگر", "کارفرما", "قرارداد کار"], "expand": ["کارمند", "استخدام", "کارفرمایی"] },
    { "term": "مزد", "match": ["مزد", "حداقل مزد", "حق السعی", "دستمزد"], "expand": ["حقوق ماهانه", "حداقل حقوق", "اضافه کار"] },
    { "term": "اخراج و خاتمه کار", "match": ["خاتمه قرارداد کار", "اخراج", "حق سنوات", "مزایای پایان کار", "بیمه بیکاری"], "expand": ["بیکاری", "تعدیل نیرو", "سنوات", "پایان کار"] },
    { "term": "مرخصی", "match": ["مرخصی"], "expand": ["تعطیلات", "استعلاجی"] },
    { "term": "بیمه", "match": ["بیمه", "بیمه گر", "بیمه گذار", "بیمه نامه"], "expand": ["پوشش بیمه"] },
    { "term": "تصادف و حوادث رانندگی", "match": ["وسیله نقلیه", "وسایل نقلیه", "حوادث رانندگی", "شخص ثالث", "راننده"], "expand": ["تصادف", "رانندگی", "ماشین", "خودرو", "موتورسیکلت"] },
    { "term": "مالیات", "match": ["مالیات", "مودی", "مودیان", "اظهارنامه", "معافیت مالیاتی"], "expand": ["مالیات بر درآمد", "مالیات حقوق", "مالیات اجاره"] },
    { "term": "شهرداری و ساختمان", "match": ["شهرداری", "عوارض", "پروانه ساختمان", "کمیسیون ماده", "شورای شهر"], "expand": ["جواز ساخت", "تخلف ساختمانی", "پایان کار ساختمان"] },
    { "term": "دیوان عدالت اداری", "match": ["دیوان عدالت اداری", "ابطال", "هیات عمومی دیوان"], "expand": ["شکایت از اداره", "شکایت از دولت"] },
    { "term": "حقوق ملت", "match": ["حقوق ملت", "آزادی", "تفتیش عقاید", "اصل برائت"], "expand": ["آزادی بیان", "حقوق شهروندی", "حریم خصوصی"] },
    { "term": "رهبری", "match": ["رهبر", "رهبری", "ولایت امر", "مجلس خبرگان"], "expand": ["ولایت فقیه"] },
    { "term": "مجلس و قانون‌گذاری", "match": ["مجلس شورای اسلامی", "شورای نگهبان", "نمایندگان", "قانون گذاری"], "expand": ["تصویب قانون", "نماینده مجلس"] },
    { "term": "قوه قضاییه", "match": ["قوه قضاییه", "قوه قضائیه", "قاضی", "قضات", "دیوان عالی کشور"], "expand": ["دادگستری"] },
    { "term": "رئیس جمهور و دولت", "match": ["رئیس جمهور", "ریاست جمهوری"], "expand": ["دولت", "کابینه"] },
    { "term": "مرور زمان", "match": ["مرور زمان"], "expand": ["مهلت قانونی", "شمول مرور زمان"] },
    { "term": "داوری", "match": ["داوری", "داور", "رای داور"], "expand": ["حکمیت"] },
    { "term": "شوراهای حل اختلاف", "match": ["شورای حل اختلاف", "صلح و سازش", "دادگاه صلح"], "expand": ["سازش", "مصالحه"] }
  ]
}
