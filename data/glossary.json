    { "term": "دادخواست", "match": ["دادخواست", "خواهان", "خوانده", "دعوا", "دعوی"], "expand": ["طرح دعوا", "شکایت حقوقی", "دادگاه حقوقی"] },
    { "term": "تجدیدنظر", "match": ["تجدیدنظر", "تجدید نظر", "واخواهی", "فرجام", "اعاده دادرسی"], "expand": ["اعتراض به رای", "اعتراض به حکم"] },
    { "term": "وکالت", "match": ["وکالت", "وکیل", "موکل"], "expand": ["وکالتنامه", "وکالت نامه", "وکیل گرفتن"] },
    { "term": "اعسار", "match": ["اعسار", "معسر", "تقسیط"], "expand": ["ناتوانی مالی", "عدم توانایی پرداخت", "قسطی کردن"] },
    { "term": "اجرای احکام", "match": ["اجرای حکم", "اجراییه", "محکوم له", "محکوم علیه", "توقیف", "مستثنیات دین"], "expand": ["اجرای رای", "توقیف اموال"] },
