{
  "description": "واژه‌نامه مفاهیم حقوقی برای برچسب‌گذاری کلیدواژه‌ها (match) و جستجوی مفهومی/هم‌معنایابی (expand). عبارات match باید دقیق و کم‌ابهام باشند؛ expand می‌تواند واژگان عامیانه را هم شامل شود.",
  "concepts": [
    { "term": "مهریه", "match": ["مهریه", "مهرالمثل", "مهرالمسمی", "صداق"], "expand": ["مهر زن", "سکه مهریه"] },
    { "term": "طلاق", "match": ["طلاق", "طلاق خلع", "طلاق رجعی"], "expand": ["جدایی", "متارکه", "طلاق گرفتن"] },
    { "term": "نفقه", "match": ["نفقه"], "expand": ["خرجی", "هزینه زندگی زن"] },
    { "term": "حضانت", "match": ["حضانت", "ملاقات طفل"], "expand": ["سرپرستی فرزند", "نگهداری فرزند", "نگهداری بچه"] },
    { "term": "نکاح", "match": ["نکاح", "ازدواج", "زوجیت", "زوجه", "زوج"], "expand": ["عقد ازدواج", "زناشویی", "همسر"] },
    { "term": "عسر و حرج", "match": ["عسر و حرج"], "expand": ["سختی زندگی", "طلاق از طرف زن"] },
    { "term": "ارث", "match": ["ارث", "ترکه", "وراث", "ورثه", "میراث", "متوفی"], "expand": ["وراثت", "سهم الارث", "انحصار وراثت"] },
    { "term": "وصیت", "match": ["وصیت", "موصی", "وصی", "موصی به"], "expand": ["وصیت نامه"] },
    { "term": "قصاص", "match": ["قصاص"], "expand": ["قصاص نفس", "قصاص عضو"] },
    { "term": "دیه", "match": ["دیه", "ارش"], "expand": ["خونبها", "خون بها", "غرامت جانی"] },
    { "term": "قتل", "match": ["قتل"], "expand": ["آدم کشی", "کشتن"] },
    { "term": "ضرب و جرح", "match": ["ضرب و جرح", "جرح", "جراحت", "صدمه"], "expand": ["کتک", "کتک کاری", "زخمی کردن", "آسیب بدنی"] },
    { "term": "سرقت", "match": ["سرقت", "سارق"], "expand": ["دزدی", "دزد"] },
    { "term": "کلاهبرداری", "match": ["کلاهبرداری", "کلاه برداری"], "expand": ["فریب", "اغفال", "حیله"] },
    { "term": "خیانت در امانت", "match": ["خیانت در امانت"], "expand": ["امانت داری", "پس ندادن امانت"] },
    { "term": "جعل", "match": ["جعل", "تزویر", "مجعول"], "expand": ["سند جعلی", "امضای جعلی", "جعل امضا"] },
    { "term": "رشوه", "match": ["رشوه", "ارتشا", "ارتشاء", "راشی", "مرتشی"], "expand": ["زیرمیزی"] },
    { "term": "اختلاس", "match": ["اختلاس"], "expand": ["سوءاستفاده از اموال دولتی"] },
    { "term": "توهین و افترا", "match": ["توهین", "افترا", "هتک حیثیت", "نشر اکاذیب", "قذف"], "expand": ["فحاشی", "ناسزا", "تهمت", "آبروریزی", "فحش"] },
    { "term": "تهدید", "match": ["تهدید", "اخاذی"], "expand": ["باج گیری", "ارعاب"] },
    { "term": "جرایم رایانه‌ای", "match": ["رایانه", "رایانه ای", "داده ها", "سامانه های رایانه ای", "مخابراتی"], "expand": ["اینترنت", "هک", "فضای مجازی", "سایبری", "شبکه اجتماعی"] },
    { "term": "حبس", "match": ["حبس", "زندان"], "expand": ["زندانی", "محبوس"] },
    { "term": "جزای نقدی", "match": ["جزای نقدی"], "expand": ["جریمه", "جریمه نقدی"] },
